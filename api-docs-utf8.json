        "/api/v1/questions": {
            "get": {
                "tags": [
                    "Question"
                ],
                "summary": "Search questions with page or cursor pagination",
                "operationId": "search",
                "parameters": [
                    {
                        "name": "arg0",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/SearchQuestionRequest"
                        }
                    },
                    {
                        "name": "mode",
                        "in": "query",
                        "description": "Pagination mode. Use PAGE or CURSOR. Defaults to PAGE when omitted.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "PAGE",
                                "CURSOR"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page index (0-based). Use only when mode=PAGE."
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Page size for both PAGE and CURSOR modes."
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "description": "Cursor token. Optional for first CURSOR request; required for next pages."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Search result",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiCollectionResponseQuestionResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "type": "about:blank",
                                    "title": "Internal server error",
                                    "status": 500,
                                    "code": "SYS-001",
                                    "detail": "An unexpected internal error occurred.",
                                    "instance": "/api/v1/questions"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Question"
                ],
                "summary": "Create a question",
                "operationId": "create",
