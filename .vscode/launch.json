{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start All Apps (npm run dev)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Start Shell Only (npm run dev:shell)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:shell"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Chrome: Shell",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:9100",
            "webRoot": "${workspaceFolder}/apps/shell",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*"
            }
        },
        {
            "name": "Debug Edge: Shell",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:9100",
            "webRoot": "${workspaceFolder}/apps/shell",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*"
            }
        }
    ],
    "compounds": [
        {
            "name": "Start & Debug Shell (Chrome)",
            "configurations": [
                "Start Shell Only (npm run dev:shell)",
                "Debug Chrome: Shell"
            ]
        }
    ]
}